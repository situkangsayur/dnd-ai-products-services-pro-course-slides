% =============================================================================
%  Frame title — thin accent rule, title, optional kicker on the right
% =============================================================================
\newcommand{\itb@kickernow}{}
\newcommand{\framekicker}[1]{\renewcommand{\itb@kickernow}{#1}}

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,sep=0pt]{frametitle}%
    \vskip 12pt
    \hspace*{0.055\paperwidth}%
    \begin{minipage}{0.89\paperwidth}
      \ifx\itb@kickernow\@empty\else
        {\fontsize{6.6}{8}\selectfont\bfseries\color{accent}%
         \MakeUppercase{\itb@kickernow}\par}\vskip 2pt
      \fi
      \global\let\itb@kickernow\@empty
      {\color{fg}\fontsize{15.5}{18.5}\selectfont\bfseries
       \raggedright\insertframetitle\par}
      \vskip 5pt
      {\color{accent}\rule{34pt}{1.6pt}}%
      {\color{rule}\rule{0.86\paperwidth}{0.6pt}}%
    \end{minipage}
    \vskip 9pt
  \end{beamercolorbox}%
}

% =============================================================================
%  Footline — brand · deck title, progress rule, page number
% =============================================================================
\newcount\itb@pct
\setbeamertemplate{footline}{%
  \ifitb@progress
    % Draw the bar from an integer percentage rather than by dividing the page
    % width by the frame count. Dividing directly raises "Dimension too large"
    % on the final frame -- \inserttotalframenumber is not reliably a plain
    % number at that point, so the guarded division still blows up. Percentages
    % keep every intermediate value small and bounded.
    \itb@pct=0\relax
    \begingroup
      \@tempcnta=\inserttotalframenumber\relax
      \ifnum\@tempcnta>0\relax
        \@tempcntb=\insertframenumber\relax
        \multiply\@tempcntb by 100\relax
        \divide\@tempcntb by \@tempcnta\relax
        \ifnum\@tempcntb>100\relax \@tempcntb=100\relax \fi
        \global\itb@pct=\@tempcntb
      \fi
    \endgroup
    \begin{tikzpicture}[remember picture,overlay]
      \fill[rule] (current page.south west) rectangle ++(\paperwidth, 1.6pt);
      \ifnum\itb@pct>0\relax
        \fill[itbblue] (current page.south west) rectangle
          ++(\the\dimexpr\itb@pct\dimexpr\paperwidth/100\relax\relax, 1.6pt);
      \fi
    \end{tikzpicture}%
  \fi
  \hbox{%
    \hspace*{0.055\paperwidth}%
    \parbox[b]{0.62\paperwidth}{\raggedright
      {\fontsize{6.2}{7.4}\selectfont\color{fg3}\itb@brand}\par\vskip 5pt}%
    \hfill
    \parbox[b]{0.28\paperwidth}{\raggedleft
      {\fontsize{6.6}{7.4}\selectfont\color{fg3}\ttfamily
       \insertframenumber\,/\,\inserttotalframenumber}\par\vskip 5pt}%
    \hspace*{0.055\paperwidth}%
  }%
}

% Content frames get generous, consistent side margins.
\setbeamersize{text margin left=0.055\paperwidth, text margin right=0.055\paperwidth}

% =============================================================================
%  Cover
% =============================================================================
\newcommand{\itb@chip}[2]{%
  \tikz[baseline=(n.base)]{
    \node[inner xsep=7pt,inner ysep=4pt,rounded corners=7pt,
          draw=signalbr!35,fill=white!8,text=dink2,
          font=\fontsize{6.6}{8}\selectfont] (n)
      {\textcolor{signalbr}{\textbf{#1}}~~#2};}%
}

\newcommand{\covertitle}{%
{%
\setbeamercolor{background canvas}{bg=itbnavy}
\begin{frame}[plain,noframenumbering]
\begin{tikzpicture}[remember picture,overlay]
  % ambient wash, matching the web cover
  \fill[itbblue,opacity=0.30] ($(current page.north west)+(-2,1)$)
    ellipse [x radius=7.2cm, y radius=4.6cm];
  \fill[signalbr,opacity=0.10] ($(current page.north east)+(0.4,-0.6)$)
    ellipse [x radius=5.4cm, y radius=3.6cm];
  \fill[violetbr,opacity=0.09] ($(current page.south east)+(-1.4,0.2)$)
    ellipse [x radius=5.0cm, y radius=3.2cm];
  % faint technical grid
  \begin{scope}
    \clip (current page.south west) rectangle (current page.north east);
    \foreach \x in {0,1.1,...,17} {
      \draw[dink,opacity=0.045,line width=0.4pt]
        ($(current page.south west)+(\x,0)$) -- ($(current page.north west)+(\x,0)$);}
    \foreach \y in {0,1.1,...,10} {
      \draw[dink,opacity=0.045,line width=0.4pt]
        ($(current page.south west)+(0,\y)$) -- ($(current page.south east)+(0,\y)$);}
  \end{scope}
\end{tikzpicture}%
\vspace*{0.045\paperheight}
\hspace*{0.055\paperwidth}%
\begin{minipage}[t]{0.86\paperwidth}
  \IfFileExists{\itb@logo}{\raisebox{-3.4mm}{\includegraphics[height=11mm]{\itb@logo}}\hspace{4mm}}{}%
  \begin{minipage}[b]{0.60\paperwidth}
    {\fontsize{7.4}{9.4}\selectfont\color{dink}\textbf{Institut Teknologi Bandung}}\par
    {\fontsize{6.6}{8.4}\selectfont\color{dink3}Directorate of Continuing Professional Education}\par
    \ifx\itb@partner\@empty\else
      {\fontsize{6.6}{8.4}\selectfont\color{dink3}in partnership with \itb@partner}\par
    \fi
  \end{minipage}

  \vskip 11pt
  \ifx\itb@kicker\@empty\else
    {\fontsize{7.2}{9}\selectfont\bfseries\color{signalbr}%
     \MakeUppercase{\itb@kicker}\par}\vskip 4pt
    {\color{signalbr}\rule{26pt}{1.4pt}}\par\vskip 7pt
  \fi
  {\color{dink}\fontsize{24}{27.5}\selectfont\bfseries\raggedright\itb@title\par}
  \ifx\itb@subtitle\@empty\else
    \vskip 7pt
    {\color{dink2}\fontsize{9.4}{12.6}\selectfont\raggedright\itb@subtitle\par}
  \fi
  \vskip 11pt
  \ifx\itb@duration\@empty\else\itb@chip{Duration}{\itb@duration}\hspace{3pt}\fi
  \ifx\itb@pname\@empty\else\itb@chip{Instructor}{\itb@pname}\fi
  % The source line is long enough to run off the plate beside the others, so
  % it gets its own row rather than being truncated at the right margin.
  \ifx\itb@source\@empty\else\par\vskip 5pt\itb@chip{Source}{\itb@source}\fi
\end{minipage}
\end{frame}
}%
}

% =============================================================================
%  Section divider
