% =============================================================================
%  itbpro.sty  —  Beamer theme for
%  "Designing and Building AI Products and Services: AI for Professional"
%  Institut Teknologi Bandung · Direktorat Pendidikan Profesional Berkelanjutan
%
%  Deliberately not a stock Beamer theme. All default chrome (navigation
%  symbols, shadowed blocks, the sidebar) is removed and rebuilt: a dark
%  ITB-blue cover and section divider, light content frames that survive both a
%  bright training room and a black-and-white handout printer, a thin progress
%  rule in the footer, and tcolorbox-based cards / code / output panels that
%  mirror the web deck one-for-one.
%
%  Engine: pdflatex (Inter + Fira Mono, both from TeX Live — no fontspec, so it
%  compiles on a plain texlive-full box with no system font hunting).
%
%  Options
%    dark      dark content frames as well as cover (default: light content)
%    noprogress   drop the footer progress rule
%
%  Usage
%    \documentclass[aspectratio=169,11pt]{beamer}
%    \usepackage{itbpro}
%    \coursetitle{...}\coursesubtitle{...}\coursekicker{Chapter 1}
%    \coursepresenter{Name}{Role}\coursesource{...}\courseduration{90 menit}
%    \begin{document}\covertitle ... \end{document}
% =============================================================================

\NeedsTeXFormat{LaTeX2e}
