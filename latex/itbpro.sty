\newcommand{\coursesection}[3]{%
{%
\setbeamercolor{background canvas}{bg=itbnavy2}
\begin{frame}[plain,noframenumbering]
\begin{tikzpicture}[remember picture,overlay]
  \fill[signalbr,opacity=0.11] ($(current page.east)+(-1.0,0.4)$)
    ellipse [x radius=6.4cm, y radius=4.2cm];
  \fill[itbblue,opacity=0.26] ($(current page.south west)+(0.5,-0.5)$)
    ellipse [x radius=6.0cm, y radius=3.6cm];
\end{tikzpicture}%
\vspace*{0.20\paperheight}
\hspace*{0.055\paperwidth}%
\begin{minipage}{0.84\paperwidth}
  {\fontsize{40}{44}\selectfont\ttfamily\bfseries\color{signalbr!45}#1}\\[4pt]
  {\color{dink}\fontsize{20}{24}\selectfont\bfseries\raggedright#2\par}
  \ifx\relax#3\relax\else
    \vskip 7pt {\color{dink2}\fontsize{9.5}{13}\selectfont\raggedright#3\par}
  \fi
\end{minipage}
\end{frame}
}%
}

