% =============================================================================
%  Code + program output
% =============================================================================
\definecolor{codebg}   {HTML}{F7FAFE}
\definecolor{codekw}   {HTML}{8B39B8}
\definecolor{codestr}  {HTML}{2E7D32}
\definecolor{codecom}  {HTML}{7387A3}
\definecolor{codenum}  {HTML}{C2571A}
\definecolor{codefn}   {HTML}{1B5FB8}

\lstdefinestyle{itbpy}{
  language=Python,
  basicstyle=\ttfamily\fontsize{7.2}{8.9}\selectfont\color{ink},
  keywordstyle=\color{codekw}\bfseries,
  stringstyle=\color{codestr},
  commentstyle=\color{codecom}\itshape,
  emphstyle=\color{codefn},
  numberstyle=\ttfamily\tiny\color{ink3},
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  breakindent=10pt,
  % No \textcolor here: listings measures the postbreak box while it is
  % still expanding, and a colour command in it derails that measurement.
  postbreak=\mbox{$\hookrightarrow$\space},
  tabsize=4,
  columns=fullflexible,
  keepspaces=true,
  upquote=true,
  literate=%
    {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
    {—}{{---}}1 {–}{{--}}1 {“}{{``}}1 {”}{{''}}1 {’}{{'}}1 {…}{{\ldots}}1
    {×}{{x}}1 {→}{{->}}2 {≈}{{~}}1 {≤}{{<=}}2 {≥}{{>=}}2,
}

% A code panel with a small header strip naming the listing and the language.
%
% The body is pulled from a file with \lstinputlisting rather than typed inline
% as verbatim. That is what keeps these frames out of [fragile]: beamer reads a
% frame body as an argument, which inline verbatim cannot survive, and [fragile]
% in turn is incompatible with [shrink]. Reading from a file sidesteps both, and
% the emitted files are runnable on their own.
\newtcolorbox{icodebox}[2][python]{
  enhanced, sharp corners=all, rounded corners, arc=3.2pt,
  boxrule=0.5pt, colback=codebg, colframe=rule,
  left=6pt, right=6pt, top=5pt, bottom=5pt,
  before skip=5pt, after skip=5pt,
  title={\hbox to \linewidth{%
    \color{ink3}\ttfamily\fontsize{6.2}{7.6}\selectfont #2\hfill
    \color{signal}\ttfamily\fontsize{5.8}{7}\selectfont\bfseries\MakeUppercase{#1}}},
  fonttitle=\normalfont, coltitle=ink3,
  colbacktitle=papertint, titlerule=0.4pt,
  attach boxed title to top, boxed title style={empty, boxrule=0pt},
}
% \icode{lang}{label}{file}
\newcommand{\icode}[3]{%
  \begin{icodebox}[#1]{#2}\lstinputlisting[style=itbpy]{#3}\end{icodebox}}

% Verbatim program output -- visibly a result, not source.
\lstdefinestyle{itbout}{
  basicstyle=\ttfamily\fontsize{7}{8.8}\selectfont\color{ink},
  breaklines=true, columns=fullflexible, keepspaces=true,
  showstringspaces=false, upquote=true,
}
\newtcolorbox{ioutputbox}{
  enhanced, sharp corners, rounded corners, arc=3pt,
  boxrule=0.5pt, leftrule=2.2pt,
  colback=limebr!7, colframe=lime!45,
  left=7pt, right=7pt, top=13pt, bottom=6pt,
  before skip=5pt, after skip=5pt,
  overlay={\node[anchor=north west,text=lime,
                 font=\fontsize{5.6}{7}\selectfont\bfseries,
                 inner sep=0pt] at ([shift={(7pt,-4.5pt)}]frame.north west) {OUTPUT};},
}
% \ioutput{file}
\newcommand{\ioutput}[1]{%
  \begin{ioutputbox}\lstinputlisting[style=itbout]{#1}\end{ioutputbox}}

% =============================================================================
%  Tables
% =============================================================================
% Header cells may contain \inlinecode, which is a tikzpicture. \MakeUppercase
% expands its argument and mangles the picture's terminating semicolon, so the
% uppercasing is done by \MakeTextUppercase, which leaves such boxes alone.
\newcommand{\thead}[1]{{\color{signal}\fontsize{7.4}{9}\selectfont\bfseries
  \MakeTextUppercase{#1}}}
\newenvironment{itable}[1]
  {\vskip 3pt\begingroup
   \renewcommand{\arraystretch}{1.28}
   \fontsize{8.2}{10.6}\selectfont\color{ink2}
   \setlength{\tabcolsep}{6pt}
   \begin{tabular}{#1}\toprule}
  {\bottomrule\end{tabular}\endgroup\vskip 3pt}

% =============================================================================
%  Resource link row (notebook / repo / chapter)
% =============================================================================
\newcommand{\reslink}[3]{%
  \tikz[baseline=(n.base)]{\node[inner xsep=6pt,inner ysep=3.4pt,rounded corners=4pt,
    draw=rule,fill=papertint,line width=0.5pt,align=left] (n)
    {\begin{tabular}{@{}l@{}}
       {\color{ink3}\ttfamily\fontsize{5.6}{6.8}\selectfont\MakeUppercase{#1}}\\[1pt]
       {\color{ink}\fontsize{7.6}{9}\selectfont\hlink{#3}{#2}}
     \end{tabular}};}\hspace{3pt}}

% =============================================================================
%  Dark content frame — for the few slides that want the web deck's look
% =============================================================================
\newenvironment{darkframe}[1][]
  {\begingroup
   \setbeamercolor{background canvas}{bg=itbnavy}
   \colorlet{fg}{dink}\colorlet{fg2}{dink2}\colorlet{fg3}{dink3}
   \colorlet{accent}{signalbr}
   \setbeamercolor{normal text}{fg=dink,bg=itbnavy}\usebeamercolor[fg]{normal text}
   \begin{frame}[#1]}
  {\end{frame}\endgroup}

